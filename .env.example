ENVIRONMENT=development
LOG_LEVEL=INFO

# Discord application and bot token
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_DEVELOPMENT_GUILD_ID=
DISCORD_MEMBERS_INTENT_ENABLED=true

# Turso/libSQL credentials. Obtain the URL with `turso db show <name> --url`
# and create a database token with `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Only these users and/or roles may run /ticket administration commands.
# Comma-separated Discord snowflake IDs.
TICKET_ADMIN_USER_IDS=606751416261935123,812827883088642048
TICKET_ADMIN_ROLE_IDS=
